{
  "name": "flower-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Secure backend API for the Flower Shop app. The only service allowed to talk to Neon.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@hono/node-server": "^2.1.5",
    "@neondatabase/serverless": "^1.2.0",
    "hono": "^4.13.13",
    "libphonenumber-js": "^1.13.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
