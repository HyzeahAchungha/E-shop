# Copy to .env (never commit it). These secrets live on the server only.
# Clerk dashboard -> API keys -> Secret key (starts with sk_). Never put it in the mobile app.
CLERK_SECRET_KEY=
# Neon dashboard -> Connect -> connection string (use the pooled string).
DATABASE_URL=
# Optional. Defaults to 8787.
PORT=8787
# Optional. Clerk dashboard -> API keys -> "JWT public key" (PEM). When set, tokens are
# verified without a network call to Clerk, which is faster and works if Clerk is slow.
CLERK_JWT_KEY=
