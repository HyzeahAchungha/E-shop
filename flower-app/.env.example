# Copy to .env.local and use your Clerk dashboard's publishable key.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Never put Clerk secret keys or Neon database credentials in the mobile app.
# Configure the Clerk application for email/password and email verification codes.
# Enable Apple, Google and Facebook providers and allow flower-shop://signup
# and flower-shop://signin as mobile redirect URLs. OAuth needs an iOS/Android development build.
# Address of the Flower API (the flower-api folder). It is public: an address only, never a secret.
# Use https in production. For local testing on a phone, use your computer's network address, for
# example http://192.168.1.20:8787 (plain http is accepted in development builds only).
EXPO_PUBLIC_API_URL=
